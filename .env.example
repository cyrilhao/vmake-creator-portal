# PostgreSQL connection string. Supabase Postgres works here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Used by Next.js and auth integrations later.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Optional: configure the separate internal admin domain.
ADMIN_APP_HOSTNAMES="admin.vmake.localhost"

# Discord OAuth app credentials for creator login.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
